{
  "name": "gaming-stake-server",
  "version": "1.0.0",
  "description": "High-performance gaming stake server with real-time casino and sports betting",
  "main": "dist/server.js",
  "scripts": {
    "start": "NODE_ENV=production concurrently \"node dist/server.js\" \"node dist/corn.server.js\"",
    "dev": "NODE_ENV=development nodemon src/server.ts",
    "dev:all": "concurrently -n server,cron -c green,blue \"npm run dev\" \"npm run cron\"",
    "cron": "nodemon src/corn.server.ts",
    "build": "tsc",
    "build:clean": "rm -rf dist && npm run build",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist logs/*.log",
    "clean:all": "rm -rf dist node_modules package-lock.json logs/*.log",
    "install:clean": "npm run clean:all && npm install",
    "health": "curl -s http://localhost:7080/health | jq '.'",
    "logs": "tail -f logs/server.log",
    "logs:casino": "tail -f logs/casino-socket/casino-socket-$(date +%Y-%m-%d).log",
    "logs:sport": "tail -f logs/sport-settlement/sport-settlement-$(date +%Y-%m-%d).log",
    "redis:flush": "redis-cli FLUSHALL",
    "redis:info": "redis-cli INFO",
    "redis:monitor": "redis-cli MONITOR",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "docker:build": "docker build -t gaming-stake-server .",
    "docker:run": "docker run -p 7080:7080 gaming-stake-server",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "deps:update": "npm update",
    "deps:check": "npm outdated"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grv24/gaming-stake-server.git"
  },
  "author": "Gourav",
  "license": "ISC",
  "keywords": [
    "gaming",
    "betting",
    "casino",
    "sports",
    "real-time",
    "socket.io",
    "typescript",
    "node.js",
    "postgresql",
    "redis"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "bugs": {
    "url": "https://github.com/grv24/gaming-stake-server/issues"
  },
  "homepage": "https://github.com/grv24/gaming-stake-server#readme",
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "https-proxy-agent": "^7.0.6",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.10",
    "pg": "^8.16.1",
    "pino": "^9.9.0",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "socks-proxy-agent": "^8.0.5",
    "typeorm": "^0.3.27",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/date-fns": "^2.6.3",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/socket.io-client": "^1.4.36",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.1.2",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2",
    "nodemon": "^3.1.10",
    "cross-env": "^7.0.3",
    "pm2": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/debug/**",
      "!src/**/*.test.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,js,json",
    "ignore": [
      "src/**/*.test.ts",
      "src/**/*.spec.ts"
    ],
    "exec": "ts-node src/server.ts"
  }
}
